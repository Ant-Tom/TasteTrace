POSTGRES_DB=tastetrace
POSTGRES_USER=tastetrace_user
POSTGRES_PASSWORD=tastetrace_password
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=5173

JWT_SECRET=change-me-super-secret-jwt-key-at-least-32-chars
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=14

PUBLIC_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
# IP of a reverse proxy in front of the backend (Caddy/nginx); leave empty without one.
TRUSTED_PROXIES=

