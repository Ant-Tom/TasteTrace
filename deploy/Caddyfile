# Single entry point in production: HTTPS certificates are issued and renewed automatically.
# The site and the API share one domain, so the browser needs no CORS and never talks
# to the backend or frontend containers directly.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Up to 6 photos of 5 MB per upload.
	request_body {
		max_size 32MB
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
